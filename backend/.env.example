# ─── Core ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio
FRONTEND_URL=https://portfoliopublisher.vercel.app

# ─── Auth / Tokens ─────────────────────────────────────
JWT_SECRET=your_super_secret_access_token_key_change_me
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_TTL_DAYS=30
# Pepper added to OTP hashes (any long random string)
OTP_PEPPER=change_me_to_a_long_random_string

# ─── AES-256-GCM URL Encryption ─────────────────────────
# 32-byte encryption key (64 hex characters or 32 random bytes)
ROUTE_ENCRYPTION_KEY=d7a3f4e8b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8
# Fallback key for seamless key rotation
ROUTE_ENCRYPTION_KEY_FALLBACK=e8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7

# Set true when serving frontend + backend on different domains over HTTPS
COOKIE_SECURE=false
# Cookie domain (leave blank for localhost)
COOKIE_DOMAIN=

# ─── Email (SMTP) ──────────────────────────────────────
# If these are left blank, OTP/emails are printed to the server console
# (dev fallback) so you can still test the full flow without a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Portfolio publisher <no-reply@yourapp.com>"

# ─── Administrator Bootstrap (npm run seed:admin) ─────
# Non-interactive CLI seed credentials for the initial SUPER_ADMIN account
ADMIN_USERNAME=nexora_admin
ADMIN_EMAIL=admin@nexora.dev
ADMIN_PASSWORD=change_this_secure_admin_password_123!

# ─── Gemini AI Suite (NEXORA AI Integration) ─────────
# Used for server-side profile summaries, post polishing, project breakdowns,
# and recruiter assistant. If unset, graceful offline heuristics are used.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
